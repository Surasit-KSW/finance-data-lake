# Finance Data Lake — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── Cloud Database (Vercel/Neon) ───────────────────────────────────────────────
# Leave empty to use local DuckDB (for local dev)
DATABASE_URL=

# ── API URL ───────────────────────────────────────────────────────────────────
DATA_LAKE_URL=http://localhost:8000

# ── Claude / Anthropic API ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Telegram Bot ──────────────────────────────────────────────────────────────
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram chat IDs allowed to use the bot.
# To find your ID: start the bot with /start — it replies with your chat ID.
# Example: TELEGRAM_ALLOWED_USERS=123456789,987654321
TELEGRAM_ALLOWED_USERS=

# ── Google Drive (optional) ───────────────────────────────────────────────────
# Required only for /report command Drive export.
# 1. Create a Google Cloud project + service account
# 2. Enable Sheets API, Docs API, Drive API
# 3. Download service account JSON key → save to 08_Config/
# 4. Share your target Drive folder with the service account email
# Path to service account JSON key file:
GOOGLE_SERVICE_ACCOUNT_JSON=
# Google Drive folder ID (from the folder URL: .../folders/<FOLDER_ID>):
GOOGLE_DRIVE_FOLDER_ID=

# ── Bot Tuning (optional — defaults are sensible) ────────────────────────────
# CACHE_TTL_SECONDS=300
# BOT_REPORT_CHAR_LIMIT=4000
# MAX_HISTORY_EXCHANGES=3
# CLAUDE_HAIKU_MODEL=claude-haiku-4-5-20251001
# CLAUDE_SONNET_MODEL=claude-sonnet-4-6
