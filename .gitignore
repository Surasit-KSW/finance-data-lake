# ══════════════════════════════════════════════════════════════
# Finance Data Lake — .gitignore
# Code + schema goes to git. Data files stay local or in Neon DB.
# ══════════════════════════════════════════════════════════════

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# ── Virtual environments ─────────────────────────────────────
.venv/
venv/
env/

# ── Secrets / Environment ────────────────────────────────────
.env
.env.local
.env.*.local
*.secret

# ── Data files — Tier-based classification ───────────────────
#
# T1 (NEVER cloud): raw SAP transactions — too sensitive
01_Bronze_Raw/
02_Silver_Cleaned/master_gl_*.parquet
02_Silver_Cleaned/master_sales_*.parquet
02_Silver_Cleaned/master_production_*.parquet
02_Silver_Cleaned/master_ar_*.parquet
02_Silver_Cleaned/master_ap_*.parquet
02_Silver_Cleaned/master_tb_*.parquet
02_Silver_Cleaned/master_ksb1_*.parquet
02_Silver_Cleaned/master_mb51_*.parquet
02_Silver_Cleaned/master_prd_*.parquet
#
# T2 (OK for cloud, committed to git): computed/aggregated — NOT raw transactions
# 02_Silver_Cleaned/ga_performance_*.parquet   ← allowed (committed)
# 02_Silver_Cleaned/ga_production_*.parquet    ← allowed (committed)
# 02_Silver_Cleaned/ga_tb_*.parquet            ← allowed (committed)
# 02_Silver_Cleaned/amc_performance_*.parquet  ← allowed (committed)
# 03_Gold_DataMarts/Summary_GL_*.parquet       ← allowed (committed)
#
# T1 Gold (keep local): audit/detailed financial statements
03_Gold_DataMarts/gold_leadsheet.parquet
03_Gold_DataMarts/gold_related_party.parquet
03_Gold_DataMarts/gold_elimination.parquet
03_Gold_DataMarts/gold_ppe.parquet
03_Gold_DataMarts/gold_cashflow.parquet
03_Gold_DataMarts/gold_gp_by_plant.parquet
03_Gold_DataMarts/gold_revenue_monthly.parquet
03_Gold_DataMarts/v_gl_summary.parquet
#
04_Reports/                    # output Excel reports — local only
06_Scripts/leadsheet/output/
*.xlsx
*.xls
*.csv

# ── Databases (local only) ───────────────────────────────────
*.duckdb
*.duckdb.wal
*.db
*.sqlite
*.sqlite3

# ── Logs ────────────────────────────────────────────────────
*.log
logs/

# ── OS / Editor ─────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# ── Node ─────────────────────────────────────────────────────
node_modules/
.next/

# ── Vercel ───────────────────────────────────────────────────
.vercel/

# ── Streamlit ────────────────────────────────────────────────
.streamlit/secrets.toml

.vercel
.env*.local

# ── Claude Code internal files ───────────────────────────────
.claude/scheduled_tasks.lock
.claude/settings.local.json

# ── 07_Workspace (Finance Ops scripts) ──────────────────────
# local Excel outputs
07_Workspace/02_Working/
# Google OAuth token + client secret
07_Workspace/.credentials/
client_secret_*.json
